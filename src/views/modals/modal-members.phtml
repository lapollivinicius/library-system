<div
  class="modal fade"
  id="memberDetailsModal"
  tabindex="-1"
  aria-labelledby="memberDetailsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="memberDetailsModalLabel">
            Member Details
          </h5>
          <small class="text-body-secondary">
            Complete information about the Member
          </small>
        </div>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form
        action="/api/members/update"
        method="POST"
        data-confirm="The data will be modified when you click Save. Are you sure?"
      >
        <div class="modal-body">
          <input type="hidden" name="id" value="1" />
          <div class="row g-4">
            <div class="col-12">
              <label for="memberName" class="form-label text-body-secondary">
                Name
              </label>
              <input
                type="text"
                class="form-control member-field"
                id="memberName"
                name="name"
                value="MEMBER NAME"
                style="border: 1px solid transparent"
                required
              />
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="memberEmail" class="form-label text-body-secondary">
                  Email
                </label>
                <input
                  type="email"
                  class="form-control member-field"
                  id="memberEmail"
                  name="email"
                  value="member@email.com"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="memberPhone" class="form-label text-body-secondary">
                  Phone
                </label>
                <input
                  type="text"
                  class="form-control member-field"
                  id="memberPhone"
                  name="phone"
                  value="(48) 99999-9999"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label
                  for="memberDocument"
                  class="form-label text-body-secondary"
                >
                  Document
                </label>
                <input
                  type="text"
                  class="form-control member-field"
                  id="memberDocument"
                  name="document"
                  value="000.000.000-00"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div
                class="d-flex justify-content-between align-items-center border rounded p-3 h-100"
              >
                <div>
                  <small class="text-body-secondary d-block">
                    Loan Status
                  </small>
                  <span class="fw-semibold"> Current status </span>
                </div>
                <span class="badge text-bg-warning"> With Loan </span>
              </div>
            </div>
            <div class="col-12">
              <div class="border rounded p-3">
                <div
                  class="d-flex justify-content-between align-items-center mb-3"
                >
                  <div>
                    <h6 class="mb-0">Active Loans</h6>
                    <small class="text-body-secondary">
                      Books currently borrowed
                    </small>
                  </div>
                  <span class="badge text-bg-secondary"> 02 loans </span>
                </div>
                <div
                  class="d-flex justify-content-between align-items-center border-top py-3"
                >
                  <div>
                    <span class="fw-semibold d-block"> BOOK TITLE </span>
                    <small class="text-body-secondary">
                      Loan: 15/08/2026
                    </small>
                  </div>
                  <div class="text-end">
                    <small class="text-body-secondary d-block"> Return </small>
                    <span class="fw-semibold"> 20/08/2026 </span>
                  </div>
                </div>
                <div
                  class="d-flex justify-content-between align-items-center border-top py-3"
                >
                  <div>
                    <span class="fw-semibold d-block"> ANOTHER BOOK </span>
                    <small class="text-body-secondary">
                      Loan: 16/08/2026
                    </small>
                  </div>
                  <div class="text-end">
                    <small class="text-body-secondary d-block"> Return </small>
                    <span class="fw-semibold"> 25/08/2026 </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-secondary"
            id="cancelMemberButton"
            data-bs-dismiss="modal"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-success" id="saveMemberButton">
            <i class="bi bi-check-lg me-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
