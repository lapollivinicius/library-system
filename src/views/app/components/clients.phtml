<div class="container-fluid mb-3">
  <div class="row mb-4">
    <div class="col">
      <p class="fw-bold fs-4 m-0">CLIENTS</p>
      <small class="text-secondary m-0"> Client registration and search </small>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-12">
      <div class="accordion shadow-sm" id="clientAccordion">
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button
              class="accordion-button collapsed"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#clientForm"
              aria-expanded="true"
              aria-controls="clientForm"
            >
              <i class="bi bi-person-plus-fill me-2"></i>
              Register Client
            </button>
          </h2>
          <div
            id="clientForm"
            class="accordion-collapse collapse"
            data-bs-parent="#clientAccordion"
          >
            <div class="accordion-body">
              <form action="/clients" method="POST">
                <div class="row g-3">
                  <!-- NAME -->
                  <div class="col-12 col-md-6">
                    <label for="name" class="form-label"> Name </label>

                    <input
                      type="text"
                      class="form-control"
                      id="name"
                      name="name"
                      placeholder="Client name"
                      required
                    />
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="email" class="form-label"> Email </label>

                    <input
                      type="email"
                      class="form-control"
                      id="email"
                      name="email"
                      placeholder="client@email.com"
                      required
                    />
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="phone" class="form-label"> Phone </label>

                    <input
                      type="text"
                      class="form-control"
                      id="phone"
                      name="phone"
                      placeholder="Phone number"
                      required
                    />
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="document" class="form-label"> Document </label>

                    <input
                      type="text"
                      class="form-control"
                      id="document"
                      name="document"
                      placeholder="Document number"
                      required
                    />
                  </div>
                  <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                      <i class="bi bi-check-lg me-1"></i>
                      Register Client
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-body">
          <h5 class="mb-0">Search Clients</h5>
          <small class="text-body-secondary"> Find registered clients </small>
        </div>
        <div class="card-body">
          <form action="/clients" method="GET">
            <div class="row g-3">
              <div class="col-12 col-md-4">
                <label for="searchField" class="form-label"> Search by </label>
                <select class="form-select" id="searchField" name="field">
                  <option value="name">Name</option>
                  <option value="email">Email</option>
                  <option value="phone">Phone</option>
                  <option value="document">Document</option>
                </select>
              </div>
              <div class="col-12 col-md-6">
                <label for="search" class="form-label"> Search </label>
                <input
                  type="text"
                  class="form-control"
                  id="search"
                  name="search"
                  placeholder="Enter your search..."
                />
              </div>
              <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                  <i class="bi bi-search me-1"></i>
                  Search
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div
          class="card-header bg-body d-flex justify-content-between align-items-center"
        >
          <div>
            <h5 class="mb-0">Clients</h5>
            <small class="text-body-secondary"> Registered clients </small>
          </div>
          <span class="badge text-bg-secondary"> 00 clients </span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Document</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr
                role="button"
                data-bs-toggle="modal"
                data-bs-target="#clientDetailsModal"
              >
                <td>CLIENT NAME</td>
                <td>client@email.com</td>
                <td>(48) 99999-9999</td>
                <td>000.000.000-00</td>
                <td>
                  <span class="badge text-bg-warning"> With Loan </span>
                </td>
              </tr>

              <tr>
                <td colspan="5" class="text-center text-body-secondary py-4">
                  No clients found.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
