<div class="container-fluid mb-3">
  <div class="row mb-4">
    <div class="col">
      <p class="fw-bold fs-4 m-0">BOOKS</p>
      <small class="text-secondary m-0"> Book registration and search </small>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-12">
      <div class="accordion shadow-sm" id="bookAccordion">
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button
              class="accordion-button collapsed"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#bookForm"
              aria-expanded="true"
              aria-controls="bookForm">
              <i class="bi bi-plus-circle-fill me-2"></i>
              Register Book
            </button>
          </h2>
          <div
            id="bookForm"
            class="accordion-collapse collapse"
            data-bs-parent="#bookAccordion">
            <div class="accordion-body">
              <form action="/books" method="POST">
                <div class="row g-3">




                  <div class="col-12 col-md-6 position-relative">
                    <label for="title" class="form-label">Title</label>

                    <input
                      type="text"
                      class="form-control"
                      id="title"
                      name="title"
                      placeholder="Book title"
                      autocomplete="off"
                      data-autocomplete-url="/api/books"
                      data-autocomplete-search-param="title"
                      data-autocomplete-target="book-title-results"
                      data-autocomplete-min="2"
                      aria-autocomplete="list"
                      aria-expanded="false"
                      required />

                    <div
                      id="book-title-results"
                      class="position-absolute start-0 end-0 text-bg-dark border rounded-3 shadow-sm mt-1 overflow-auto"
                      style="max-height: 300px; z-index: 1050;"
                      role="listbox"
                      hidden>

                      <button
                        type="button"
                        class="dropdown-item p-3 border-bottom"
                        data-autocomplete-option="Clean Code"
                        data-value="15"
                        data-label="Clean Code">
                        <div class="fw-semibold">Clean Code</div>
                        <small class="text-body-secondary">
                          Robert C. Martin
                        </small>
                      </button>


                    </div>
                  </div>




                  <div class="col-12 col-md-6">
                    <label for="author" class="form-label"> Author </label>
                    <input
                      type="text"
                      class="form-control"
                      id="author"
                      name="author"
                      placeholder="Author name"
                      required />
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="year" class="form-label"> Year </label>
                    <input
                      type="number"
                      class="form-control"
                      id="year"
                      name="year"
                      placeholder="2026"
                      min="0"
                      required />
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="genre" class="form-label"> Genre </label>
                    <input
                      type="text"
                      class="form-control"
                      id="genre"
                      name="genre"
                      placeholder="Genre"
                      required />
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="quantity" class="form-label"> Quantity </label>
                    <input
                      type="number"
                      class="form-control"
                      id="quantity"
                      name="quantity"
                      placeholder="0"
                      min="1"
                      required />
                  </div>
                  <div class="col-12">
                    <label for="isbn" class="form-label"> ISBN </label>
                    <input
                      type="text"
                      class="form-control"
                      id="isbn"
                      name="isbn"
                      placeholder="ISBN"
                      required />
                  </div>
                  <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                      <i class="bi bi-check-lg me-1"></i>
                      Register Book
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-body">
          <h5 class="mb-0">Search Books</h5>
          <small class="text-body-secondary"> Find registered books </small>
        </div>
        <div class="card-body">
          <form action="/books" method="GET">
            <div class="row g-3">
              <div class="col-12 col-md-4">
                <label for="searchField" class="form-label"> Search by </label>
                <select class="form-select" id="searchField" name="field">
                  <option value="code">Code</option>
                  <option value="title">Name</option>
                  <option value="author">Author</option>
                  <option value="year">Year</option>
                </select>
              </div>
              <div class="col-12 col-md-6">
                <label for="search" class="form-label"> Search </label>
                <input
                  type="text"
                  class="form-control"
                  id="search"
                  name="search"
                  placeholder="Enter your search..." />
              </div>
              <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                  <i class="bi bi-search me-1"></i>
                  Search
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div
          class="card-header bg-body d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0">Search Results</h5>
            <small class="text-body-secondary"> Registered books </small>
          </div>
          <span class="badge text-bg-secondary"> 00 books </span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Year</th>
                <th>Quant</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>

              <tr
                role="button"
                data-bs-toggle="modal"
                data-bs-target="#bookDetailsModal">
                <td>BOOK TITLE</td>
                <td>AUTHOR NAME</td>
                <td>2026</td>
                <td>00</td>
                <td>
                  <span class="badge text-bg-success"> status </span>
                </td>
              </tr>

              <tr>
                <td colspan="5" class="text-center text-body-secondary py-4">
                  No books found.
                </td>
              </tr>

            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>