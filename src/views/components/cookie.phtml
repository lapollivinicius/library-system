<div
  id="cookieBanner"
  class="d-none position-fixed bottom-0 start-0 w-100 p-3"
  style="z-index: 1080"
>
  <div class="container">
    <div class="border border-secondary rounded-4 bg-body shadow-lg p-4">
      <div class="row align-items-center g-4">
        <div class="col-12 col-lg">
          <div class="d-flex gap-3">
            <i class="bi bi-cookie text-primary fs-3"></i>
            <div>
              <h2 class="fs-5 fw-bold mb-2">We use cookies</h2>
              <p class="text-secondary mb-2">
                We use necessary cookies to make Library System work properly.
                With your permission, we may also use optional cookies to
                understand how the Service is used and improve your experience.
              </p>
              <a href="/privacy" class="small text-decoration-none">
                Learn more about our Privacy Policy
              </a>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-auto">
          <div class="d-flex flex-column flex-sm-row gap-2">
            <button
              type="button"
              id="cookieReject"
              class="btn btn-outline-secondary"
            >
              Necessary only
            </button>
            <button type="button" id="cookieAccept" class="btn btn-primary">
              Accept all
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>