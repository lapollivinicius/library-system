<div
  class="modal fade"
  id="bookDetailsModal"
  tabindex="-1"
  aria-labelledby="bookDetailsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="bookDetailsModalLabel">Book Details</h5>

          <small class="text-body-secondary">
            View and edit book information
          </small>
        </div>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form
        action="/api/books/update"
        method="POST"
        data-confirm="Are you sure?"
      >
        <div class="modal-body">
          <input type="hidden" name="id" value="1" />
          <div class="row g-4">
            <div class="col-12">
              <label for="bookTitle" class="form-label text-body-secondary">
                Title
              </label>
              <input
                type="text"
                class="form-control book-field"
                id="bookTitle"
                name="title"
                value="BOOK TITLE"
                style="border: 1px solid transparent"
                required
              />
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="bookAuthor" class="form-label text-body-secondary">
                  Author
                </label>
                <input
                  type="text"
                  class="form-control book-field"
                  id="bookAuthor"
                  name="author"
                  value="AUTHOR NAME"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="bookYear" class="form-label text-body-secondary">
                  Publication Year
                </label>
                <input
                  type="number"
                  class="form-control book-field"
                  id="bookYear"
                  name="year"
                  value="2026"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="bookGenre" class="form-label text-body-secondary">
                  Genre
                </label>
                <input
                  type="text"
                  class="form-control book-field"
                  id="bookGenre"
                  name="genre"
                  value="Fiction"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <label for="bookIsbn" class="form-label text-body-secondary">
                  ISBN
                </label>
                <input
                  type="text"
                  class="form-control book-field"
                  id="bookIsbn"
                  name="isbn"
                  value="978-0000000000"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="border rounded p-3">
                <label
                  for="bookQuantity"
                  class="form-label text-body-secondary"
                >
                  Quantity
                </label>
                <input
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  class="form-control book-field fs-4"
                  id="bookQuantity"
                  name="quantity"
                  value="5"
                  min="0"
                  style="border: 1px solid transparent"
                  required
                />
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="border rounded p-3 h-100">
                <small class="text-body-secondary d-block"> Available </small>
                <span class="fs-4 fw-semibold text-success"> 03 </span>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="border rounded p-3 h-100">
                <small class="text-body-secondary d-block"> Borrowed </small>
                <span class="fs-4 fw-semibold text-danger"> 02 </span>
              </div>
            </div>
            <div class="col-12">
              <div
                class="d-flex justify-content-between align-items-center border rounded p-3"
              >
                <div>
                  <small class="text-body-secondary d-block"> Status </small>
                  <span class="fw-semibold"> Book availability </span>
                </div>
                <span class="badge text-bg-success"> Available </span>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-outline-secondary"
            id="cancelBookButton"
            data-bs-dismiss="modal"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-success" id="saveBookButton">
            <i class="bi bi-check-lg me-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
